# MongoDB Atlas
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_CLUSTER_ID=
MONGO_DB_NAME=sample_mflix

# OpenRouter
OPENROUTER_API_KEY=

# Supabase (storage + Auth JWKS + Postgres)
SUPABASE_KEY=
SUPABASE_URL=
SUPABASE_AUTH_URL=
SUPABASE_DB_URL=

# SQLAlchemy async pool (uses SUPABASE_DB_URL)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# Langsmith (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# CORS (comma-separated lists)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
